    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.11.1",
    "i18next": "^26.4.2",
    "katex": "^0.18.7",
    "lucide-react": "^1.47.0",
    "png2icons": "^2.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
