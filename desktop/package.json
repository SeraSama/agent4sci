{
  "name": "agent4sci-desktop",
  "productName": "Agent4Sci",
  "version": "1.0.0",
  "description": "Agent4Sci — 自动化科研 Agent 桌面应用",
  "main": "./out/main/index.js",
  "author": "Agent4Sci",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "web": "vite --config vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "icons": "cd .. && uv run python packaging/make_icons.py",
    "dist:mac": "bash ../packaging/build-mac.sh",
    "dist:win": "powershell -ExecutionPolicy Bypass -File ../packaging/build-win.ps1"
  },
